# Nabu web: только статика SPA. API — на отдельном домене (API_BASE_URL в
# /config.json), маршрутизацию делает ingress. Используется, когда API_UPSTREAM
# не задан (Kubernetes, FTR.NAB.CMN-0001).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Служебная проверка готовности.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Конфигурация и точка входа — всегда свежие.
    location = /config.json {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Ассеты с хешем в имени — навсегда.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # SPA: любые пути отдают index.html.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri /index.html;
    }
}
